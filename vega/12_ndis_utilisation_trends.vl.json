{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "National NDIS committed-support utilisation from comparable six-month windows Oct-March in 2024, 2025, 2026 Q4 NDIA reports, national total by SIL status. Source D.28/29. This is not a direct measure of service availability. Fixed 2026-10-16: removed layered legend selection which generated duplicate chooseGroup_tuple signal. Hover tooltips retained.",
  "width": "container",
  "height": 325,
  "background": "transparent",
  "padding": {
    "left": 5,
    "right": 150,
    "top": 22,
    "bottom": 8
  },
  "data": {
    "url": "data/12_ndis_utilisation_trend.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "calculate": "toNumber(datum.report_year)",
      "as": "yr"
    },
    {
      "calculate": "toNumber(datum.utilisation_pct)",
      "as": "rate"
    }
  ],
  "encoding": {
    "x": {
      "field": "yr",
      "type": "quantitative",
      "title": "Six months ending 31 March",
      "scale": {
        "domain": [
          2023.8,
          2026.36
        ],
        "nice": false
      },
      "axis": {
        "values": [
          2024,
          2025,
          2026
        ],
        "format": "d",
        "labelFontSize": 12,
        "labelPadding": 10,
        "grid": false,
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "rate",
      "type": "quantitative",
      "title": "Plan utilisation (%)",
      "scale": {
        "domain": [
          50,
          95
        ],
        "nice": false
      },
      "axis": {
        "values": [
          50,
          60,
          70,
          80,
          90
        ],
        "gridColor": "#E5ECE7",
        "domain": false,
        "ticks": false,
        "labelFontSize": 11,
        "labelExpr": "datum.value+\"%\"",
        "titlePadding": 12
      }
    },
    "color": {
      "field": "participant_group",
      "type": "nominal",
      "title": "Participant group",
      "sort": [
        "In SIL",
        "Not in SIL",
        "All participants"
      ],
      "scale": {
        "domain": [
          "In SIL",
          "Not in SIL",
          "All participants"
        ],
        "range": [
          "#9C4A0E",
          "#F0B276",
          "#D9822B"
        ]
      },
      "legend": null
    },
    "detail": {
      "field": "participant_group",
      "type": "nominal"
    },
    "tooltip": [
      {
        "field": "participant_group",
        "title": "Group"
      },
      {
        "field": "yr",
        "title": "Year ending March",
        "type": "quantitative",
        "format": "d"
      },
      {
        "field": "rate",
        "title": "Plan budget used (%)",
        "type": "quantitative",
        "format": ".0f"
      },
      {
        "field": "measurement_start",
        "title": "Window starts"
      },
      {
        "field": "measurement_end",
        "title": "Window ends"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3.2,
        "point": false
      },
      "encoding": {
        "order": {
          "field": "yr"
        },
        "strokeDash": {
          "condition": {
            "test": "datum.participant_group === 'All participants'",
            "value": [
              7,
              5
            ]
          },
          "value": [
            1,
            0
          ]
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 145,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.8
      }
    },
    {
      "transform": [
        {
          "filter": "datum.yr == 2026"
        },
        {
          "calculate": "format(datum.rate,'.0f') + '%  ' + datum.participant_group",
          "as": "lbl"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 12,
        "fontWeight": 700
      },
      "encoding": {
        "text": {
          "field": "lbl"
        },
        "color": {
          "condition": [
            {
              "test": "datum.participant_group === 'In SIL'",
              "value": "#9C4A0E"
            },
            {
              "test": "datum.participant_group === 'Not in SIL'",
              "value": "#C27A33"
            }
          ],
          "value": "#B8661C"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.yr == 2026 && datum.participant_group !== 'All participants'"
        },
        {
          "aggregate": [
            {
              "op": "max",
              "field": "rate",
              "as": "hi"
            },
            {
              "op": "min",
              "field": "rate",
              "as": "lo"
            }
          ],
          "groupby": [
            "yr"
          ]
        },
        {
          "calculate": "(datum.hi + datum.lo) / 2",
          "as": "mid"
        },
        {
          "calculate": "format(datum.hi - datum.lo, '.0f') + ' pp gap'",
          "as": "gap"
        }
      ],
      "mark": {
        "type": "rule",
        "xOffset": -18,
        "strokeWidth": 2,
        "color": "#102D34"
      },
      "encoding": {
        "y": {
          "field": "lo",
          "type": "quantitative"
        },
        "y2": {
          "field": "hi"
        },
        "color": {
          "value": "#102D34"
        },
        "strokeDash": {
          "value": [
            1,
            0
          ]
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.yr == 2026 && datum.participant_group !== 'All participants'"
        },
        {
          "aggregate": [
            {
              "op": "max",
              "field": "rate",
              "as": "hi"
            },
            {
              "op": "min",
              "field": "rate",
              "as": "lo"
            }
          ],
          "groupby": [
            "yr"
          ]
        },
        {
          "calculate": "(datum.hi + datum.lo) / 2",
          "as": "mid"
        },
        {
          "calculate": "format(datum.hi - datum.lo, '.0f') + ' pp gap'",
          "as": "gap"
        }
      ],
      "mark": {
        "type": "text",
        "xOffset": -26,
        "align": "right",
        "baseline": "middle",
        "fontSize": 13,
        "fontWeight": 800,
        "color": "#102D34",
        "dy": -9
      },
      "encoding": {
        "y": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "field": "gap"
        },
        "color": {
          "value": "#102D34"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.yr == 2026 && datum.participant_group !== 'All participants'"
        },
        {
          "aggregate": [
            {
              "op": "max",
              "field": "rate",
              "as": "hi"
            },
            {
              "op": "min",
              "field": "rate",
              "as": "lo"
            }
          ],
          "groupby": [
            "yr"
          ]
        },
        {
          "calculate": "(datum.hi + datum.lo) / 2",
          "as": "mid"
        },
        {
          "calculate": "format(datum.hi - datum.lo, '.0f') + ' pp gap'",
          "as": "gap"
        }
      ],
      "mark": {
        "type": "text",
        "xOffset": -26,
        "align": "right",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": 400,
        "color": "#102D34",
        "dy": 8
      },
      "encoding": {
        "y": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "value": "In SIL vs not"
        },
        "color": {
          "value": "#5A7177"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelColor": "#50636A",
      "titleColor": "#455D62"
    }
  }
}
