{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "background": "transparent",
  "config": {
    "view": {
      "stroke": null
    },
    "font": "DM Sans",
    "axis": {
      "labelColor": "#405963",
      "titleColor": "#405963"
    },
    "legend": {
      "labelColor": "#3A5159",
      "titleColor": "#3A5159",
      "labelFontSize": 11
    }
  },
  "description": "NDIS plan utilisation by state and participant SIL status for Oct 2025\u2013Mar 2026; equal-size geographic tile cartogram.",
  "height": 405,
  "data": {
    "url": "data/06_ndis_utilisation_tile_map.csv",
    "format": {
      "type": "csv",
      "parse": {
        "tile_x": "number",
        "tile_y": "number",
        "utilisation_pct": "number"
      }
    }
  },
  "params": [
    {
      "name": "supportGroup",
      "value": "All participants",
      "bind": {
        "input": "select",
        "name": "Participant group: ",
        "options": [
          "All participants",
          "In supported independent living (SIL)",
          "Not in supported independent living"
        ]
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.support_group === supportGroup"
    },
    {
      "calculate": "toNumber(datum.utilisation_pct)",
      "as": "rate"
    }
  ],
  "encoding": {
    "x": {
      "field": "tile_x",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "domain": [
          0,
          1,
          2,
          3
        ],
        "paddingInner": 0.07,
        "paddingOuter": 0.11
      }
    },
    "y": {
      "field": "tile_y",
      "type": "ordinal",
      "axis": null,
      "scale": {
        "domain": [
          0,
          1,
          2,
          3
        ],
        "paddingInner": 0.08,
        "paddingOuter": 0.07
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 8,
        "stroke": "#FFFFFF",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "rate",
          "type": "quantitative",
          "title": "Budget used (%)",
          "scale": {
            "domain": [
              50,
              90
            ],
            "range": [
              "#D9EEE6",
              "#81C7BB",
              "#248B88",
              "#0C535F"
            ]
          },
          "legend": {
            "orient": "bottom",
            "gradientLength": 270,
            "titleFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "support_group",
            "type": "nominal",
            "title": "Participant group"
          },
          {
            "field": "rate",
            "type": "quantitative",
            "title": "Plan budget utilised",
            "format": ".0f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 16,
        "fontWeight": 800
      },
      "encoding": {
        "text": {
          "field": "state_code",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.rate < 72",
            "value": "#193F47"
          },
          "value": "#FFFFFF"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": 14,
        "fontSize": 17,
        "fontWeight": 800
      },
      "encoding": {
        "text": {
          "field": "rate",
          "type": "quantitative",
          "format": ".0f"
        },
        "color": {
          "condition": {
            "test": "datum.rate < 72",
            "value": "#193F47"
          },
          "value": "#FFFFFF"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": 31,
        "fontSize": 10,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "value": "% used"
        },
        "color": {
          "condition": {
            "test": "datum.rate < 72",
            "value": "#193F47"
          },
          "value": "#FFFFFF"
        }
      }
    }
  ]
}
